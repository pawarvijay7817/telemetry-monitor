{
  "name": "telemetry-monitor",
  "version": "1.0.0",
  "description": "Angular Electron Telemetry Monitoring Application",
  "main": "electron/main.js",
  "scripts": {
    "frontend": "npm --prefix frontend start",
    "backend": "npm --prefix backend run dev",
    "electron": "wait-on http://localhost:4200 && electron .",
    "dev": "concurrently -k \"npm run frontend\" \"npm run backend\" \"npm run electron\"",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:frontend",
    "test": "npm --prefix frontend test -- --watch=false && npm --prefix backend test",
    "start:electron": "electron ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "wait-on": "^9.1.0"
  }
}
